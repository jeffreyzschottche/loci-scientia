# Laat leeg om automatisch 'aitje-{DEVICE_NUMBER}.local' te gebruiken
BACKEND_HOST=
BACKEND_BIND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_HTTP=
BACKEND_WS=
BACKEND_TIMEOUT=6

API_ROUTES_DEFAULT_PORT=8080

PMTILES_HOST=127.0.0.1
PMTILES_PORT=8080
PMTILES_TILESET=europe
PMTILES_DATA_DIR=/Volumes/Expansion/loci-maps
# PMTILES_DATA_DIR=/mnt/hgfs/loci-maps
MAP_GLYPHS_URL=http://127.0.0.1:8000/fonts/{fontstack}/{range}.pbf
MAP_SPRITE_URL=http://127.0.0.1:8000/sprites/v4/light
# PMTILES_STATUS_HINT=Controleer of de pmtiles-server draait…

QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_DEVICES_COLLECTION=devices
QDRANT_DEVICES_EMBEDDED_PATH=qdrant_storage/devices_db

DEVICE_NAME_PREFIX=aitje
DEVICE_NUMBER=2
# TIMEZONE=Europe/Amsterdam
LANGUAGE=nl-NL
AITJE_RESPONSE_LANGUAGE=nl-NL
# AITJE_TODAY_DATE=2026-03-29
# DEVICE_HOSTNAME=aitje-2
# PUBLIC_BASE_URL=http://aitje-2.local:8000

OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_MODELS=gemma2:2b,gemma3:1b,gemma3:4b,qwen3.5:2b
OLLAMA_TIMEOUT=180
PROMPT_MODES=Developer,Finance,Law,Child

# Chat history summarization after global prompt-idle (0 = uit)
CHAT_SUMMARY_IDLE_MINUTES=5

# Admin-only endpoints (lokale UI)
ADMIN_USERS=ADMIN
ADMIN_DEVICE_ID=local-admin

# --- Cloudflare Tunnel ---
CF_TUNNEL_TOKEN=eyJhIjoiMTUyYjdkNDZkZWY5YWM1YWY4NmE1NGI0NzY0ZGRhNDYiLCJ0IjoiMjRlMmE0ZDEtNzg3Ni00YmJjLWE1ZGYtZDNiNjM2ZmViMzhiIiwicyI6Ik1EWmxaR1kxWkRJdE0yRTFPQzAwT0Rka0xXSTVOall0TlRjMk56ZG1NV0l4WVRJdyJ9            # Token van Cloudflare dashboard (eyJ...)
CF_DEVICE_ID=2               # Unieke device identifier (bijv. klant-001)
CF_DOMAIN=aitje.com          # Base domain
CF_SSH_PORT=22              # Lokale SSH poort (default 22)
CF_WEB_PORT=8000            # Lokale FastAPI poort (default 8000)
CF_TUNNEL_ENABLED=true      # Toggle om tunnel aan/uit te zetten
# OLLAMA_KV_QUANT: f16, q8_0, q4_0 (leeg = default).
# OLLAMA_MAX_CONTEXT: per-model lijst (index uitlijnen met OLLAMA_MODELS).
OLLAMA_KV_QUANT=q8_0
OLLAMA_MAX_CONTEXT=4000,8000,2000,2048

AITJE_DEFAULT_PROMPT_MODE=

# Laat leeg om automatisch 'aitje-{DEVICE_NUMBER}.local' te gebruiken
BACKEND_HOST=
# Standaard: 127.0.0.1 wanneer Caddy actief is (HTTPS terminatie via reverse
# proxy). Laat leeg om automatisch te kiezen, of forceer 0.0.0.0 om uvicorn
# direct op de LAN te exposeren (legacy, niet aanbevolen).
BACKEND_BIND_HOST=
BACKEND_PORT=8000
BACKEND_HTTP=
BACKEND_WS=
BACKEND_TIMEOUT=6

# --- HTTPS reverse proxy (Caddy) ---------------------------------------------
# Caddy termineert TLS op poort 443 (per-device interne CA) en proxiet naar
# uvicorn op loopback. Externe clients bezoeken eenmalig
# http://aitje-<N>.local/connect om het apparaat-CA te installeren; daarna
# werkt alles over https://aitje-<N>.local/.
CADDY_AUTOSTART=1
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Optioneel: alternatieve XDG_DATA_HOME voor Caddy. Default valt onder
# devices_db/, zodat de interne CA mee back-upt met de andere device-data.
# CADDY_DATA_HOME=

API_ROUTES_DEFAULT_PORT=8080

PMTILES_HOST=127.0.0.1
PMTILES_PORT=8080
PMTILES_TILESET=europe
PMTILES_DATA_DIR=/Volumes/Expansion/loci-maps
# PMTILES_DATA_DIR=/mnt/hgfs/loci-maps
MAP_GLYPHS_URL=http://127.0.0.1:8000/fonts/{fontstack}/{range}.pbf
MAP_SPRITE_URL=http://127.0.0.1:8000/sprites/v4/light
# PMTILES_STATUS_HINT=Controleer of de pmtiles-server draait…

QDRANT_HOST=
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_DEVICES_COLLECTION=devices
QDRANT_DEVICES_EMBEDDED_PATH=qdrant_storage/devices_db

DEVICE_NAME_PREFIX=aitje
DEVICE_NUMBER=2

# --- Kioskmodus (alleen device) ----------------------------------------------
# Bepaalt óók het activatie-beleid van lociscientia.sh (zie docs/kiosk.md):
#   1 = DEV/onderhoud. Toont een schakelaar in Instellingen → Systeem → Kioskmodus;
#       de kiosk gaat NIET automatisch aan — jij zet 'm handmatig aan/uit (toggle of
#       scripts/aitje-kiosk-apply.sh). Veilig op een werkmachine/laptop.
#   0 = ECHTE APPLIANCE. Geen schakelaar; lociscientia.sh ACTIVEERT de kiosk
#       automatisch (GDM uit, zwarte boot) zodat een vers kastje met enkel
#       ./lociscientia.sh + herstart een kiosk wordt.
# Default hier is 1 (dev-veilig). Zet op 0 op een echt kastje dat je als kiosk wilt.
SHOW_KIOSK_TOGGLE=1
# Weston erft GNOME's schermschaal niet. Op HiDPI/4K-schermen kan de kiosk anders
# kleiner lijken dan de normale desktop. Verhoog/verlaag per kastje indien nodig.
KIOSK_QT_SCALE_FACTOR=1.8

# TIMEZONE=Europe/Amsterdam
LANGUAGE=nl-NL
AITJE_RESPONSE_LANGUAGE=nl-NL
# AITJE_TODAY_DATE=2026-03-29
# DEVICE_HOSTNAME=aitje-2
# Default met Caddy actief: https://aitje-2.local. Override alleen als je
# achter een andere reverse proxy zit of een ander schema/poort wilt tonen
# in QR-codes en de devices-pagina.
# PUBLIC_BASE_URL=https://aitje-2.local
# Default: http://aitje-2.local/connect (door Caddy doorgezet naar uvicorn).
# SETUP_URL=http://aitje-2.local/connect

OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=gemma4:e2b
OLLAMA_MODELS=gemma2:2b,gemma3:1b,gemma3:4b,qwen3.5:2b,gemma4:e2b
OLLAMA_TIMEOUT=180
PROMPT_MODES=Developer,Finance,Law,Child

# Chat history summarization after global prompt-idle (0 = uit)
CHAT_SUMMARY_IDLE_MINUTES=5

# Admin-only endpoints (lokale UI)
ADMIN_USERS=ADMIN
ADMIN_DEVICE_ID=local-admin

# Remote support tunnel
JUMP_SERVER_IP=78.47.164.114           # IP of hostname van de Hetzner VPS
TUNNEL_PORT=10001              # Unieke poort per kastje (bijv. 10001)
TUNNEL_USER=support-tunnel
TUNNEL_KEY_PATH=/home/aitje/.ssh/tunnel_key
# OLLAMA_KV_QUANT: f16, q8_0, q4_0 (leeg = default).
# OLLAMA_MAX_CONTEXT: per-model lijst (index uitlijnen met OLLAMA_MODELS).
OLLAMA_KV_QUANT=q8_0
OLLAMA_MAX_CONTEXT=4000,8000,2000,2048,2000
# OLLAMA_VULKAN: 1=forceer Vulkan backend, 0=uit, leeg=auto-detect (libvulkan aanwezig → aan).
# OLLAMA_VULKAN=1

AITJE_DEFAULT_PROMPT_MODE=

# Web search via SearXNG (toggle in de chat-UI staat default uit).
# Laat SEARXNG_URL leeg om automatisch een lokale Docker-container te
# starten via lociscientia.sh; vul een URL in om een externe instance te
# gebruiken (in dat geval wordt er geen container opgespind).
SEARXNG_URL=
SEARXNG_AUTOSTART=1
SEARXNG_PORT=8888
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_CONTAINER_NAME=aitje-searxng
# SEARXNG_DATA_DIR=
SEARXNG_MAX_RESULTS=5
SEARXNG_LANGUAGE=nl
# 0 = uit, 1 = matig (default), 2 = strikt
SEARXNG_SAFESEARCH=1
SEARXNG_TIMEOUT=8
# Container stoppen bij Ctrl+C (default 0 = laten draaien voor snelle herstart)
SEARXNG_STOP_ON_EXIT=0

# Embedder (Aitje Embedding Application) — geïnternaliseerd onder /embedder.
# Draait in-process binnen FastAPI; geen los PHP/Laravel-proces meer.
# Single-tenant: precies één gebruikersaccount, gelezen uit onderstaande vars
# bij elke boot. Leeg laten = login werkt niet.
EMBEDDER_USER_EMAIL=test@test.nl
EMBEDDER_USER_PASSWORD=Test123!
EMBEDDER_USER_NAME=Test

// AITJE Plymouth splash — dark background, centered logo, yellow dot spinner.
// Brand colors mirror the Qt UI: background #0b0b0b, accent #facc15.

Window.SetBackgroundTopColor(0.043, 0.043, 0.043);
Window.SetBackgroundBottomColor(0.043, 0.043, 0.043);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_w / 2 - logo.image.GetWidth() / 2;
logo.y = screen_h / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 0);

dot_count = 5;
dot_radius = 5;
dot_gap = 16;
dot_y = logo.y + logo.image.GetHeight() + 36;
dot_total = dot_count * (dot_radius * 2) + (dot_count - 1) * (dot_gap - dot_radius * 2);
dot_start = screen_w / 2 - dot_total / 2;

fun make_dot(index) {
    sprite = Sprite();
    sprite.image = Image.Text("●", 0.98, 0.80, 0.08, 1, "Sans 18");
    sprite.SetPosition(dot_start + index * dot_gap, dot_y, 0);
    return sprite;
}

dots[0] = make_dot(0);
dots[1] = make_dot(1);
dots[2] = make_dot(2);
dots[3] = make_dot(3);
dots[4] = make_dot(4);

progress = 0;

fun refresh_callback() {
    progress = progress + 1;
    active = (progress / 6) % dot_count;
    for (i = 0; i < dot_count; i++) {
        opacity = (i == active) ? 1.0 : 0.25;
        dots[i].SetOpacity(opacity);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

message_sprite = Sprite();
message_x = 0;
message_y = 0;

fun display_message_callback(text) {
    message_sprite.SetImage(Image.Text(text, 0.85, 0.85, 0.85, 1, "Sans 12"));
    message_x = screen_w / 2 - message_sprite.GetImage().GetWidth() / 2;
    message_y = dot_y + 36;
    message_sprite.SetPosition(message_x, message_y, 0);
}

fun hide_message_callback() {
    message_sprite.SetImage(Image.Text("", 0, 0, 0, 0, "Sans 12"));
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

password_dialog = NULL;

fun display_password_callback(prompt, bullets) {
    text = prompt + " " + bullets;
    password_dialog = Image.Text(text, 0.95, 0.95, 0.95, 1, "Sans 14");
    sprite = Sprite(password_dialog);
    sprite.SetPosition(screen_w / 2 - password_dialog.GetWidth() / 2, message_y + 24, 0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

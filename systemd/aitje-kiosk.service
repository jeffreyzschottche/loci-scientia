[Unit]
Description=AITJE Kiosk (cage)
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service gdm.service gdm3.service
After=getty@tty1.service

[Service]
Type=simple
User=__AITJE_USER__
WorkingDirectory=__PROJECT_ROOT__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/__AITJE_UID__
Environment=QT_QPA_PLATFORM=wayland
Environment=AITJE_KIOSK=1
ExecStartPre=/bin/mkdir -p /run/user/__AITJE_UID__
ExecStartPre=/bin/chown __AITJE_USER__:__AITJE_USER__ /run/user/__AITJE_UID__
ExecStart=/usr/bin/cage -s -- /bin/bash -lc 'cd "__PROJECT_ROOT__" && exec ./lociscientia.sh'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
